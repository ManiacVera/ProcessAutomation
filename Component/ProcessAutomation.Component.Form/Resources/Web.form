<!DOCTYPE html>
<html lang="en">
	<head>
		<title>@TITLE</title>
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<link href="../Scripts/AngularJS/angular/jquery-ui/jquery-ui.css" rel="stylesheet">
		<link href="../Scripts/AngularJS/css/bootstrap.min.css" rel="stylesheet">
		<link href="../Scripts/AngularJS/css/bootstrap-icons.min.css" rel="stylesheet">
		<link href="../Scripts/AngularJS/css/scrollbar.css" rel="stylesheet">
		<link href="../Scripts/AngularJS/css/spinner.css" rel="stylesheet">
		<style>
			table, th, td 
			{
				border: 1px solid;
			}
		</style>
	</head>
	<body ng-app="app" id="appId">
		<div ng-controller="AppController" id="controllerId">
			<form class="form">
@FORM
			</form>
		</div>
	</body>
	
	<script src="../Scripts/AngularJS/angular/jquery.min.js" type="text/javascript"></script>
	<script src="../Scripts/AngularJS/angular/jquery-ui/jquery-ui.min.js" type="text/javascript"></script>
	<script src="../Scripts/AngularJS/js/bootstrap.min.js" type="text/javascript"></script>
	<script src="../Scripts/AngularJS/angular/angular.min.js" type="text/javascript"></script>
	<script src="../Scripts/AngularJS/angular/angularjs-contenteditable.js" type="text/javascript"></script>
	<script src="../Scripts/AngularJS/angular/angularjs-dropdown-multiselect.min.js" type="text/javascript"></script>
	<script src="../Scripts/AngularJS/angular/angular-translate.min.js" type="text/javascript"></script>
	<script src="../Scripts/AngularJS/angular/angular-translate-loader-partial.min.js" type="text/javascript"></script>
	<script>
		var app = angular.module('app', ['angularjs-dropdown-multiselect', 'pascalprecht.translate']);

		app.config(['$httpProvider', function($httpProvider) {
			//initialize get if not there
			if (!$httpProvider.defaults.headers.get) {
				$httpProvider.defaults.headers.get = {};    
			}    
			
			//disable IE ajax request caching
			$httpProvider.defaults.headers.get['If-Modified-Since'] = 'Mon, 26 Jul 1997 05:00:00 GMT';
			$httpProvider.defaults.headers.get['Cache-Control'] = 'no-cache';
			$httpProvider.defaults.headers.get['Pragma'] = 'no-cache';
		}]);
		
		app.controller("AppController", function ($scope, $translate, $translatePartialLoader, $interpolate, $http, $parse) {
			$scope.$var = {};
			$scope.$data = @DATA_PROPERTIES;
@VARIABLES			

			$scope.AddItem = function(dataTable, item) {
				if (item) {
					dataTable.push(angular.copy(item));
				}
			};
			
			$scope.DeleteItem = function(dataTable, index) {
				dataTable.splice(index, 1);
			};
			
			$scope.OnMoveUpClick = function (dataTable, index) {
				if (index > 0) {
					var grid = dataTable;
					const tmp = grid[index - 1];
					grid[index - 1] = grid[index];
					grid[index] = tmp;
				}
			};

			$scope.OnMoveDownClick = function (dataTable, index) {
				var grid = dataTable;
				if (grid != null) {
					if (index < grid.length - 1) {
						const tmp = grid[index + 1];
						grid[index + 1] = grid[index];
						grid[index] = tmp;
					}
				}
			};
		});		
		
		app.directive('changeDirective', function($compile, $parse, $interpolate, $http, $filter) {
		  return {
			restrict: 'A',
			link: function(scope, element, attributes, ctrl) {
				var attributeValue = angular.fromJson(attributes.changeDirective);
				
				if (attributeValue.ref && attributeValue.ref !== "_ref") {
					var variableRef = scope.$eval(attributeValue.ref);				
					
					if (variableRef)
					{				
						var processingDataInterval = null;
						var lastValueProcessed = null;
						var firstValueProcessed = null;
						
						var processValueByRef = function (callback) {
							try {
								switch(variableRef.type) {
									case "REST_API": {
										$http({
											method: 'GET',
											url: $interpolate(variableRef.value)(scope)
										}).then(
											function successCallback(response) {
												if (response.data) {
													if (firstValueProcessed !== lastValueProcessed) {
														firstValueProcessed = lastValueProcessed;
														console.log("Reprocessing last value");
														processValueByRef(callback);
													}
													else {
														variableRef.cache = response.data;
														callback(response.data);
														variableRef.processingData = false;
													}
												}
												else {
													if (firstValueProcessed !== lastValueProcessed) {
														firstValueProcessed = lastValueProcessed;
														console.log("Reprocessing last value");
														processValueByRef(callback);													
													}
													else {
														variableRef.cache = response;
														callback(response);
														variableRef.processingData = false;
													}
												}
											},
											function errorCallback(response) {
												if (firstValueProcessed !== lastValueProcessed) {
													firstValueProcessed = lastValueProcessed;
													console.log("Reprocessing last value");
													processValueByRef(callback);
												}
												else {
													variableRef.cache = null;
													callback(null);
													variableRef.processingData = false;
												}
											}
										);	
										
									}
									break;
									
									default: {
										variableRef.cache = $interpolate(variableRef.value)(scope);
										callback(variableRef.cache);
										variableRef.processingData = false;
									}
									break;
								}
								
							} catch (error) {
							  console.log(error);
							  variableRef.processingData = false;
							}	
						};
						
						var getValueByRef = function(callback, newValue) {
							if (variableRef && variableRef.type && variableRef.value) {
								lastValueProcessed = newValue;
								//var currentDate = parseInt($filter('date')(new Date(),'yyyyMMddmmss.sss').replace('.', ''));
							
								// LUIS VERA: NO EXISTE CACHE CONFIGURABLE SOLO CACHE AUTOMATICO AL MOMENTO GET, POST, INTERPOLATION SOBRE LA MISMA VARIABLE
								if (variableRef.processingData == false)
									// || variableRef.startTimeCache == null 								
									// || (variableRef.milliSecondsCache == null || parseInt(variableRef.milliSecondsCache) <= 0) 
									// || (currentDate - variableRef.startTimeCache) > parseInt(variableRef.milliSecondsCache))
							   {
									variableRef.processingData = true;
									firstValueProcessed = newValue;
									// variableRef.cache = null;
									// variableRef.startTimeCache = parseInt($filter('date')(new Date(),'yyyyMMddmmss.sss').replace('.', ''));
									processValueByRef(callback);
							   }
							   else {
									if (processingDataInterval != null)	{
										clearInterval(processingDataInterval);
										processingDataInterval = null;
									}
									
									//processingDataInterval = setInterval( function () { checkProcessingData(callback); }, 100);
									processingDataInterval = setInterval( function () { checkProcessingData(callback); });
							   }
							}
						};	
						
						var checkProcessingData = function(processCallback) {
							if (!variableRef.processingData) {
								clearInterval(processingDataInterval);
								processingDataInterval = null;
								scope.$apply(function(){ processCallback(variableRef.cache); });
							}
						};					
						
						var callbackValueRef = function(response) {
							try {
								var tagName = element[0].tagName;
								
								if (element[0].tagName == "INPUT" && element[0].type) {
									tagName = element[0].type.toUpperCase();
								}
							
								switch(tagName)
								{
									case "SELECT": {
										element.off();							

										var $newElement = element.clone(true);
										$newElement.removeAttr('change-directive');
										$newElement.removeAttr('ng-options');				  
										$newElement.find('option').remove().end();

										var model = $parse($newElement.attr("ng-model"));	
										
										if (response) {
											// var modelValue = scope.$eval($newElement.attr("ng-model"));
											var options = angular.toJson(response);
											
											if (angular.isArray(response)) {
												$newElement.attr("ng-options", attributeValue.option + " for $item in " + options);
											}
											else {
												$newElement.attr("ng-options", attributeValue.option + " for $item in [" + options + "]");
											}
										}
										else {
											model.assign(scope, null);
											$newElement.attr("ng-options", null);
										}
										
										$handler = $('<div>').append($newElement);

										var elementCompiled = $compile($handler.html())(scope);
										element.replaceWith(elementCompiled);
										element = elementCompiled;
									}
									break;

									case "TABLE": {
										//element.off();							
										//var elementBody = element.find('tbody');
										//var $newElement = elementBody.clone(true);
										//$newElement.removeAttr('change-directive');
										
										//var $trElement = $newElement.find("tr:first").clone(true);
										//$trElement.removeAttr('change-directive');
										//$newElement.find("tr").remove().end();
										//var model = $parse($newElement.attr("ng-model"));									
										
										//var tr = element.find('tbody').find("tr:first");
										//var model = $parse(tr.attr("ng-repeat").match(/[^ ]+/g)[tr.attr("ng-repeat").match(/[^ ]+/g).length-1]);
										var model = $parse(element.find('tbody').attr("ng-model"));	
										
										if (response) {
											if (angular.isArray(response)) {
												model.assign(scope, response);
											}
											else {
												var items = angular.toJson(response);
												model.assign(scope, angular.fromJson("[" + items + "]"));											
											}
										}
										else {
											model.assign(scope, []);
										}
										
										//$handler = $('<div>').append($newElement);
										//var elementCompiled = $compile($handler.html())(scope);
										//elementBody.replaceWith(elementCompiled);
										//elementBody = elementCompiled;
									}
									break;
									
									case "TEXT": {
										var model = $parse(element.attr("ng-model"));								
										
										if (response) {
											
											if (attributeValue.option) {
												model.assign(scope, eval(attributeValue.option.replace("$item", "response")));
											}
											else {
												model.assign(scope, response);
											}
										}else {
											model.assign(scope, null);
										}
									}
									break;

									case "LABEL": {
										element.off();							

										var $newElement = element.clone(true);
										$newElement.removeAttr('change-directive');
										$newElement.html("");
										
										if (response) {
											if (attributeValue.option) {
												$newElement.append(eval(attributeValue.option.replace("$item", "response")));
											}
											else {
												$newElement.append(response);
											}
										}
										
										$handler = $('<div>').append($newElement);

										var elementCompiled = $compile($handler.html())(scope);
										element.replaceWith(elementCompiled);
										element = elementCompiled;
									}
									break
									
									default: {
										var model = $parse(element.attr("ng-model"));
										model.assign(scope, response);	
									}
									break;
								}
										
						}
						catch (error) {
							console.log(error);
							variableRef.processingData = false;
						}
					  }

					  var actionChange = function(newVal, oldVal) {						
							if(newVal!==oldVal) {
								getValueByRef(callbackValueRef, newVal);
							}
					  }
					  
					  var initVariableRef = function() { 
							getValueByRef(callbackValueRef, null);
					  };
					  
					  initVariableRef();
					  
					  if (variableRef.watchExpression) { 
							scope.$watch(variableRef.watchExpression, actionChange);
					  }
				  }
				}
			}
		  }
		});

		app.directive('datePicker', function() {
			return {
			  restrict: 'A',
			  require: 'ngModel',
			  link: function(scope, elm, attr, ctrl){
				
				// Format date on load
				ctrl.$formatters.unshift(function(value) {
				  if(value && moment(value).isValid()){
					   return moment(new Date(value)).format('MM/DD/YYYY');
				  }
				  return value;
				})
				
				//Disable Calendar
				scope.$watch(attr.ngDisabled, function (newVal) {
				  if(newVal === true)
					$(elm).datepicker("disable");
				  else
					$(elm).datepicker("enable");
				});
				
				// Datepicker Settings
				elm.datepicker({
				  autoSize: true,
				  changeYear: true,
				  changeMonth: true,
				  dateFormat: attr["dateformat"] || 'mm/dd/yy',
				  showOn: 'button',
				  buttonText: '<i class="bi-calendar-event"></i>',
				  onSelect: function (valu) {
					scope.$apply(function () {
						ctrl.$setViewValue(valu);
					});
					elm.focus();
				  },
				  
				   beforeShow: function(){
					 debugger;
					if(attr["minDate"] != null)
						$(elm).datepicker('option', 'minDate', attr["minDate"]);
					  
					if(attr["maxDate"] != null )
						$(elm).datepicker('option', 'maxDate', attr["maxDate"]);
				  },
				  
				  
				});
			  }
			}
		});
		
	</script>
	
</html>
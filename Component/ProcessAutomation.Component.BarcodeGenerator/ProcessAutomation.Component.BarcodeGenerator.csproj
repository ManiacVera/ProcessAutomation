<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ProcessAutomation.Component</RootNamespace>
    <AssemblyName>BarcodeGeneratorComponent</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="InputFormat.json" />
    <None Remove="Resources\i18n\i18n_en-US.json" />
    <None Remove="Resources\i18n\i18n_es-MX.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="InputFormat.json" />
    <EmbeddedResource Include="Resources\i18n\i18n_en-US.json" />
    <EmbeddedResource Include="Resources\i18n\i18n_es-MX.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\ProcessAutomation.Common\ProcessAutomation.Common.csproj" />
  </ItemGroup>

  <Target Name="CopyAssembly" AfterTargets="AfterBuild" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release'">
    <ItemGroup>
      <PackageComponent Include="$(TargetDir)/$(TargetFileName);" />
      <PackageNuget Include="$(TargetDir)/*.dll;" Exclude="$(TargetDir)/Microsoft*.dll;$(TargetDir)/$(TargetFileName);" />
      <PackageExternal Include="$(TargetDir)/External/*.*;" />
    </ItemGroup>
    <Message Text="Copy PackageComponent" Importance="normal" />
    <Copy SourceFiles="@(PackageComponent)" DestinationFolder="$(SolutionDir)/Build/Component" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageNuget)" DestinationFolder="$(SolutionDir)/Build/Package" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageExternal)" DestinationFolder="$(SolutionDir)/Build/External" ContinueOnError="true" />
  </Target>

  <Target Name="CopyRuntimeFiles" AfterTargets="AfterBuild" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release'">
    <ItemGroup>
      <CopyRuntimeFiles Condition="'$(MSBuildThisFileDirectory)' != '' And HasTrailingSlash('$(MSBuildThisFileDirectory)')" Include="$(TargetDir)runtimes\win\**\System.Drawing.Common.dll;" />
    </ItemGroup>

    <Message Text="Copy CopyRuntimeFiles @(CopyRuntimeFiles)" Importance="high" />
    <Copy SourceFiles="@(CopyRuntimeFiles)" DestinationFolder="$(SolutionDir)/Build/Package" ContinueOnError="true" />
  </Target>

</Project>

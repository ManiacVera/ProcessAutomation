<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
      <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProcessAutomationApi</AssemblyName>
    <RootNamespace>ProcessAutomationApi</RootNamespace>
    <Configurations>Debug;Release</Configurations>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Business\ProcessAutomation.Business\ProcessAutomation.Business.csproj" />
    <ProjectReference Include="..\..\Common\ProcessAutomation.Common\ProcessAutomation.Common.csproj" />
    <ProjectReference Include="..\..\Framework\ProcessAutomation.Framework\ProcessAutomation.Framework.csproj" />
  </ItemGroup>

  <Target Name="RemoveBuild" BeforeTargets="PreBuildEvent">
    <RemoveDir Directories="$(SolutionDir)/Build/App/ProcessAutomationApi"></RemoveDir>
  </Target>

  <Target Name="CopyApps" BeforeTargets="PreBuildEvent">
    <ItemGroup>
      <PackageTemplateLauncherApp Include="$(SolutionDir)/Build/App/TemplateLauncherRust/template_launcher.*;" />
      <PackageRunProcessApp Include="$(SolutionDir)/Build/App/RunProcessApp/RunProcessApp.*;" />
      <PackageInterface Include="$(SolutionDir)/Build/App/RunProcessApp/ProcessAutomation.Interface.dll;" />
    </ItemGroup>
    <Message Text="Copy PackageExeRun" Importance="normal" />
    <RemoveDir Directories="$(TargetDir)/Templates"></RemoveDir>
    <Copy SourceFiles="@(PackageTemplateLauncherApp)" DestinationFolder="$(TargetDir)/Templates" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageRunProcessApp)" DestinationFolder="$(TargetDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageInterface)" DestinationFolder="$(TargetDir)" ContinueOnError="true" />
  </Target>
  
	<Target Name="CopyNetCore" AfterTargets="AfterBuild;Publish" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release'">
		<ItemGroup>
			<CopyNetCoreFiles Include="$(TargetDir)clrjit.dll;$(TargetDir)coreclr.dll;$(TargetDir)hostfxr.dll;$(TargetDir)hostpolicy.dll;$(TargetDir)Microsoft.Extensions.Caching.Memory.dll;$(TargetDir)Microsoft.CSharp.dll;$(TargetDir)Microsoft.AspNetCore.Authentication.Abstractions.dll;$(TargetDir)Microsoft.AspNetCore.Authentication.Core.dll;$(TargetDir)Microsoft.AspNetCore.Authentication.dll;$(TargetDir)Microsoft.AspNetCore.Authorization.dll;$(TargetDir)Microsoft.AspNetCore.Authorization.Policy.dll;$(TargetDir)Microsoft.AspNetCore.Connections.Abstractions.dll;$(TargetDir)Microsoft.AspNetCore.Cors.dll;$(TargetDir)Microsoft.AspNetCore.dll;$(TargetDir)Microsoft.AspNetCore.HostFiltering.dll;$(TargetDir)Microsoft.AspNetCore.Hosting.Abstractions.dll;$(TargetDir)Microsoft.AspNetCore.Hosting.dll;$(TargetDir)Microsoft.AspNetCore.Hosting.Server.Abstractions.dll;$(TargetDir)Microsoft.AspNetCore.Http.Abstractions.dll;$(TargetDir)Microsoft.AspNetCore.Http.dll;$(TargetDir)Microsoft.AspNetCore.Http.Features.dll;$(TargetDir)Microsoft.AspNetCore.HttpOverrides.dll;$(TargetDir)Microsoft.AspNetCore.Metadata.dll;$(TargetDir)Microsoft.AspNetCore.Mvc.Abstractions.dll;$(TargetDir)Microsoft.AspNetCore.Mvc.ApiExplorer.dll;$(TargetDir)Microsoft.AspNetCore.Mvc.Core.dll;$(TargetDir)Microsoft.AspNetCore.Mvc.Cors.dll;$(TargetDir)Microsoft.AspNetCore.Mvc.DataAnnotations.dll;$(TargetDir)Microsoft.AspNetCore.Mvc.dll;$(TargetDir)Microsoft.AspNetCore.Routing.Abstractions.dll;$(TargetDir)Microsoft.AspNetCore.Routing.dll;$(TargetDir)Microsoft.AspNetCore.Server.IIS.dll;$(TargetDir)Microsoft.AspNetCore.Server.IISIntegration.dll;$(TargetDir)Microsoft.AspNetCore.Server.Kestrel.Core.dll;$(TargetDir)Microsoft.AspNetCore.Server.Kestrel.dll;$(TargetDir)Microsoft.AspNetCore.Server.Kestrel.Transport.NamedPipes.dll;$(TargetDir)Microsoft.AspNetCore.Server.Kestrel.Transport.Quic.dll;$(TargetDir)Microsoft.AspNetCore.Server.Kestrel.Transport.Sockets.dll;$(TargetDir)Microsoft.EntityFrameworkCore.dll;$(TargetDir)Microsoft.Extensions.Configuration.Abstractions.dll;$(TargetDir)Microsoft.Extensions.Configuration.Binder.dll;$(TargetDir)Microsoft.Extensions.Configuration.dll;$(TargetDir)Microsoft.Extensions.Configuration.EnvironmentVariables.dll;$(TargetDir)Microsoft.Extensions.Configuration.FileExtensions.dll;$(TargetDir)Microsoft.Extensions.Configuration.Json.dll;$(TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll;$(TargetDir)Microsoft.Extensions.DependencyInjection.dll;$(TargetDir)Microsoft.Extensions.DependencyModel.dll;$(TargetDir)Microsoft.Extensions.Diagnostics.Abstractions.dll;$(TargetDir)Microsoft.Extensions.Diagnostics.dll;$(TargetDir)Microsoft.Extensions.Features.dll;$(TargetDir)Microsoft.Extensions.FileProviders.Abstractions.dll;$(TargetDir)Microsoft.Extensions.FileProviders.Physical.dll;$(TargetDir)Microsoft.Extensions.Hosting.Abstractions.dll;$(TargetDir)Microsoft.Extensions.Hosting.dll;$(TargetDir)Microsoft.Extensions.Localization.Abstractions.dll;$(TargetDir)Microsoft.Extensions.Logging.Abstractions.dll;$(TargetDir)Microsoft.Extensions.Logging.Configuration.dll;$(TargetDir)Microsoft.Extensions.Logging.Console.dll;$(TargetDir)Microsoft.Extensions.Logging.Debug.dll;$(TargetDir)Microsoft.Extensions.Logging.dll;$(TargetDir)Microsoft.Extensions.Logging.EventLog.dll;$(TargetDir)Microsoft.Extensions.Logging.EventSource.dll;$(TargetDir)Microsoft.Extensions.ObjectPool.dll;$(TargetDir)Microsoft.Extensions.Options.ConfigurationExtensions.dll;$(TargetDir)Microsoft.Extensions.Options.dll;$(TargetDir)Microsoft.Extensions.Primitives.dll;$(TargetDir)Microsoft.Net.Http.Headers.dll;$(TargetDir)Microsoft.OpenApi.dll;$(TargetDir)Microsoft.Win32.Primitives.dll;$(TargetDir)Microsoft.Win32.Registry.dll;$(TargetDir)msquic.dll;$(TargetDir)Swashbuckle.AspNetCore.Swagger.dll;$(TargetDir)Swashbuckle.AspNetCore.SwaggerGen.dll;$(TargetDir)Swashbuckle.AspNetCore.SwaggerUI.dll;$(TargetDir)System.Collections.Concurrent.dll;$(TargetDir)System.Collections.dll;$(TargetDir)System.Collections.NonG
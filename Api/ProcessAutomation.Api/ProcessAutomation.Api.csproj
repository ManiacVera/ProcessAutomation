		</ItemGroup>

		<Message Text="Copy CopyNetCore" Importance="high" />
		<Copy SourceFiles="@(CopyNetCoreFiles)" DestinationFolder="$(SolutionDir)Build\App\ProcessAutomationApi" SkipUnchangedFiles="true" ContinueOnError="true" />
	</Target>

  <Target Name="CopyRuntimeFiles" AfterTargets="AfterBuild;Publish" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release'">
    <ItemGroup>
      <CopyRuntimeCommon Include="$(TargetDir)runtimes\$(ActiveCommonFolder)\**\*.*" />
      <CopyRuntimeSpecific Include="$(TargetDir)runtimes\$(ActiveRuntime)\**\*.*" />
    </ItemGroup>

    <Message Text="Copy CopyRuntimeFiles" Importance="high" />
    <Copy SourceFiles="@(CopyRuntimeCommon)" DestinationFolder="$(SolutionDir)/Build/runtimes/$(ActiveCommonFolder)/%(RecursiveDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(CopyRuntimeSpecific)" DestinationFolder="$(SolutionDir)/Build/runtimes/$(ActiveRuntime)/%(RecursiveDir)" ContinueOnError="true" />
  </Target>

  <Target Name="CopyAssembly" AfterTargets="AfterBuild;Publish" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release'">
    <ItemGroup>
      <PackageApp Include="$(TargetDir)$(TargetName).*;" Exclude="$(TargetDir)$(TargetName).json;$(TargetDir)$(TargetName).xml;$(TargetDir)$(TargetName).pdb" />
      <PackageAppResources Include="$(TargetDir)Resources/*.*;" />
      <PackageForm Include="$(TargetDir)Form/**/*.*;" />
      <PackageProcessFiles Include="$(TargetDir)ProcessFiles/*.json;" />
      <PackageNuget Include="$(SolutionDir)/Build/Package/*.dll;" />
      <PackageLocalNuget Include="$(TargetDir)Microsoft.AspNetCore.*.dll;$(TargetDir)Swashbuckle*.dll;$(TargetDir)Microsoft.OpenApi.dll;" />
      <PackageCommon Include="$(SolutionDir)Build/Package/ProcessAutomation.Business*.dll;$(SolutionDir)Build/Package/ProcessAutomation.Common*.dll;$(SolutionDir)Build/Package/ProcessAutomation.Framework*.dll;$(SolutionDir)Build/Package/Microsoft.Extensions.DependencyModel.dll;$(SolutionDir)Build/Package/Microsoft.EntityFrameworkCore.dll;$(SolutionDir)Build/Package/Microsoft.Bcl.AsyncInterfaces.dll;$(SolutionDir)Build/Package/Microsoft.CSharp.dll" />
      <PackageComponent Include="$(SolutionDir)/Build/Component/*.dll;" />
      <PackageExternal Include="$(SolutionDir)/Build/External/*.exe;" />
      <PackagePages Include="$(SolutionDir)/Build/Resources/Pages/*.html;" />
      <PackageConfigServerConnection Include="$(SolutionDir)/Build/Config/ServerConnection.json;" />
      <PackageUserSettings Include="$(SolutionDir)/Build/Config/UserSettings.json;" />
      <PackageTemplateLauncherApp Include="$(SolutionDir)/Build/App/TemplateLauncherRust/template_launcher.*;" />
      <PackageRunProcessApp Include="$(SolutionDir)/Build/App/RunProcessApp/RunProcessApp.*;" />
      <PackageInterface Include="$(SolutionDir)/Build/App/RunProcessApp/ProcessAutomation.Interface.dll;" />

      <BaseRuntimesCommon Include="$(SolutionDir)/Build/runtimes/$(ActiveCommonFolder)/**/*.*;" />
      <BaseRuntimesNative Include="$(SolutionDir)/Build/runtimes/$(ActiveRuntime)/native/**/*.*;" />
      <BaseRuntimesLib Include="$(SolutionDir)/Build/runtimes/$(ActiveRuntime)/lib/netcoreapp3.1/**/*.*;" />
    </ItemGroup>

    <Message Text="Copy PackageApp" Importance="normal" />
    <Copy SourceFiles="@(PackageLocalNuget)" DestinationFolder="$(SolutionDir)/Build/Package" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageApp)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageAppResources)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Resources" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageForm)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Form/%(RecursiveDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageCommon)" DestinationFolder="$(SolutionDir)Build/App/ProcessAutomationApi" ContinueOnError="true" />
    
    <Copy SourceFiles="@(PackageTemplateLauncherApp)" DestinationFolder="$(SolutionDir)Build/App/ProcessAutomationApi/Templates" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageRunProcessApp)" DestinationFolder="$(SolutionDir)Build/App/ProcessAutomationApi" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageInterface)" DestinationFolder="$(SolutionDir)Build/App/ProcessAutomationApi" ContinueOnError="true" />

    <Copy SourceFiles="@(PackageLocalNuget)" DestinationFolder="$(SolutionDir)Build/App/ProcessAutomationApi" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageProcessFiles)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/ProcessFiles" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageNuget)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Package" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageComponent)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Component" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageExternal)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/External" ContinueOnError="true" />
    <Copy SourceFiles="@(PackagePages)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Resources/Pages" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageConfigServerConnection)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Config" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageUserSettings)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Config" ContinueOnError="true" />

    <Copy SourceFiles="@(BaseRuntimesCommon)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Package/runtimes/$(ActiveCommonFolder)/%(RecursiveDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(BaseRuntimesNative)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Package/runtimes/$(ActiveRuntime)/native/%(RecursiveDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(BaseRuntimesLib)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomationApi/Package/runtimes/$(ActiveRuntime)/lib/netcoreapp3.1/%(RecursiveDir)" ContinueOnError="true" />

    <RemoveDir Directories="$(TargetDir)/Component"></RemoveDir>
    <RemoveDir Directories="$(TargetDir)/Package"></RemoveDir>
    <RemoveDir Directories="$(TargetDir)/External"></RemoveDir>
    <RemoveDir Directories="$(TargetDir)/Resources/Pages"></RemoveDir>
    <RemoveDir Directories="$(TargetDir)/Viewer"></RemoveDir>
    <RemoveDir Directories="$(TargetDir)/BaseRuntimes"></RemoveDir>

    <Copy SourceFiles="@(PackageComponent)" DestinationFolder="$(TargetDir)/Component" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageNuget)" DestinationFolder="$(TargetDir)/Package" ContinueOnError="true" />
    
    <Copy SourceFiles="@(BaseRuntimesCommon)" DestinationFolder="$(TargetDir)/Package/runtimes/$(ActiveCommonFolder)/%(RecursiveDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(BaseRuntimesNative)" DestinationFolder="$(TargetDir)/Package/runtimes/$(ActiveRuntime)/native/%(RecursiveDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(BaseRuntimesLib)" DestinationFolder="$(TargetDir)/Package/runtimes/$(ActiveRuntime)/lib/netcoreapp3.1/%(RecursiveDir)" ContinueOnError="true" />

    <Copy SourceFiles="@(PackageExternal)" DestinationFolder="$(TargetDir)/External" ContinueOnError="true" />
    <Copy SourceFiles="@(PackagePages)" DestinationFolder="$(TargetDir)/Resources/Pages" ContinueOnError="true" />
  </Target>

  <Target Name="CopyAssemblyRemaining" AfterTargets="AfterBuild;Publish" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release'">
    <ItemGroup>
        <AllTargetDlls Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <ItemGroup>
        <RemainingDlls Include="@(AllTargetDlls)" Condition="!Exists('$(SolutionDir)Build\App\ProcessAutomationApi\%(Filename)%(Extension)')" />
    </ItemGroup>
    <Message Text="Remaining DLLs: @(RemainingDlls)" Importance="High" />
    <Copy SourceFiles="@(RemainingDlls)" DestinationFolder="$(SolutionDir)Build\Package\" />
    <Copy SourceFiles="@(RemainingDlls)" DestinationFolder="$(SolutionDir)Build\App\ProcessAutomationApi\Package\" />
  </Target>

</Project>

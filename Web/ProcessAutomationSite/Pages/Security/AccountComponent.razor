@page "/Account"
@attribute [Authorize]
@using ProcessAutomationSite.Pages.Common;
@using Microsoft.Extensions.Localization;
@inject IStringLocalizer<AccountComponent> localizer

<br />
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <div class="row bg-dark rounded shadow" style="border-left: 0px; border-right: 0px; border-top: 15px; border-bottom: 15px; border-style: solid; border-color: orange;">
            <div class="col-md-12">
                <br />
                <RadzenFieldset class="rounded shadow" Style="color: white; font-size: 20px;">
                    <HeaderTemplate>
                        <RadzenLabel Text="@localizer["UserAccount"]" Style="color: white; font-size: 22px;"></RadzenLabel>
                    </HeaderTemplate>
                    <ChildContent>
                        <div class="row" style="margin-bottom: 6px;">
                            <div class="col-md-12">
                                <RadzenTextBox Name="Email" @bind-Value="@userInfo.Email" Style="width: 100%; font-size: 20px;"
                                               Disabled="true"
                                               @onkeydown="@OnEnter"></RadzenTextBox>
                            </div>
                        </div>
                        <div class="row" style="margin-bottom: 8px;">
                            <div class="col-md-12">
                                <RadzenPassword Name="Password" @bind-Value="@oldPassword" Style=" width: 100%; font-size: 20px;"
                                                Placeholder="@localizer["OldPassword"]"
                                                @oninput="@OnInputOldPassword"
                                                @onkeydown="@OnEnter"></RadzenPassword>
                            </div>
                        </div>
                        <div class="row" style="margin-bottom: 8px;">
                            <div class="col-md-12">
                                <RadzenPassword Name="Password" @bind-Value="@newPassword" Style=" width: 100%; font-size: 20px;"
                                                Placeholder="@localizer["NewPassword"]"
                                                @oninput="@OnInputNewPassword"
                                                @onkeydown="@OnEnter"></RadzenPassword>
                            </div>
                        </div>
                        <div class="row" style="margin-bottom: 8px;">
                            <div class="col-md-12">
                                <RadzenButton Text="@localizer["ChangePassword"]" Click="@OnSave" Style="width: 100%"></RadzenButton>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12" style="text-align: center;">
                                <h4>@message</h4>
                            </div>
                        </div>
                    </ChildContent>
                </RadzenFieldset>
                <br />
            </div>
        </div>
    </div>
    <div class="col-md-2"></div>
</div>
<LoadingComponent @ref="loadingComponent" />
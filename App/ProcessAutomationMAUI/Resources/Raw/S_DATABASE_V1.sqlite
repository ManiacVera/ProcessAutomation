/****** Object:  Table CAT_COMPONENT ******/
CREATE TABLE IF NOT EXISTS CAT_COMPONENT
(
	ID_Component INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Component VARCHAR (50) NOT NULL,
	Component_Code VARCHAR (100) NULL,
	Creation_Date DATETIME NOT NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);

/****** Object:  Table CAT_ENCAPSULATED_PARTITION_TYPE ******/
CREATE TABLE IF NOT EXISTS CAT_ENCAPSULATED_PARTITION_TYPE
(
	ID_Encapsulated_Partition_Type INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Encapsulated_Partition_Type VARCHAR (50) NOT NULL,
	Encapsulated_Partition_Type_Code VARCHAR (50) NULL,
	Creation_Date DATETIME NOT NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);

/****** Object:  Table CAT_VALUE_TYPE ******/
CREATE TABLE IF NOT EXISTS CAT_VALUE_TYPE
(
	ID_Value_Type INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Value_Type VARCHAR (50) NOT NULL,
	Value_Type_Code VARCHAR (50) NULL,
	Creation_Date DATETIME NOT NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);

/****** Object:  Table CAT_VALUE_OUTPUT_TYPE ******/
CREATE TABLE IF NOT EXISTS CAT_VALUE_OUTPUT_TYPE
(
	ID_Value_Output_Type INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Value_Output_Type VARCHAR (50) NOT NULL,
	Value_Output_Type_Code VARCHAR (50) NULL,
	Creation_Date DATETIME NOT NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);

/****** Object:  Table CAT_DECLARATION_TYPE ******/
CREATE TABLE IF NOT EXISTS CAT_DECLARATION_TYPE
(
	ID_Declaration_Type INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Declaration_Type VARCHAR (50) NOT NULL,
	Declaration_Type_Code VARCHAR (50) NULL,
	Creation_Date DATETIME NOT NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);

/****** Object:  Table CAT_RESULT_PARAMETER ******/
CREATE TABLE IF NOT EXISTS CAT_RESULT_PARAMETER
(
	ID_Result_Parameter INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Result_Parameter VARCHAR (100) NOT NULL,
	Value VARCHAR (1000) NULL,
	Control_Type VARCHAR (50) NULL,
	Creation_Date DATETIME NOT NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);

/****** Object:  Table CAT_FILE ******/
CREATE TABLE IF NOT EXISTS CAT_FILE
(
	ID_File INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	File_Name VARCHAR (100) NOT NULL,
	File_Type VARCHAR (100) NOT NULL,
	Source VARCHAR(131072) NOT NULL,
	Version FLOAT NOT NULL,
	Creation_Date DATETIME NOT NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);

/****** Object:  Table SEC_TABLE_CONTROL ******/
CREATE TABLE IF NOT EXISTS SEC_TABLE_CONTROL
(
	ID_Table_Control INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Table_Name VARCHAR (200) NOT NULL,
	Creation_Date DATETIME NOT NULL,
	Last_Update DATETIME NULL,
	Active INTEGER NOT NULL
);

INSERT INTO SEC_TABLE_CONTROL (Table_Name, Creation_Date, Last_Update, Active)
SELECT 'CAT_COMPONENT', datetime('now'), datetime('now'), 1
WHERE NOT EXISTS(SELECT 1 FROM SEC_TABLE_CONTROL WHERE Table_Name = 'CAT_COMPONENT');

INSERT INTO SEC_TABLE_CONTROL (Table_Name, Creation_Date, Last_Update, Active)
SELECT 'CAT_ENCAPSULATED_PARTITION_TYPE', datetime('now'), datetime('now'), 1
WHERE NOT EXISTS(SELECT 1 FROM SEC_TABLE_CONTROL WHERE Table_Name = 'CAT_ENCAPSULATED_PARTITION_TYPE');

INSERT INTO SEC_TABLE_CONTROL (Table_Name, Creation_Date, Last_Update, Active)
SELECT 'CAT_VALUE_TYPE', datetime('now'), datetime('now'), 1
WHERE NOT EXISTS(SELECT 1 FROM SEC_TABLE_CONTROL WHERE Table_Name = 'CAT_VALUE_TYPE');

INSERT INTO SEC_TABLE_CONTROL (Table_Name, Creation_Date, Last_Update, Active)
SELECT 'CAT_VALUE_OUTPUT_TYPE', datetime('now'), datetime('now'), 1
WHERE NOT EXISTS(SELECT 1 FROM SEC_TABLE_CONTROL WHERE Table_Name = 'CAT_VALUE_OUTPUT_TYPE');

INSERT INTO SEC_TABLE_CONTROL (Table_Name, Creation_Date, Last_Update, Active)
SELECT 'CAT_DECLARATION_TYPE', datetime('now'), datetime('now'), 1
WHERE NOT EXISTS(SELECT 1 FROM SEC_TABLE_CONTROL WHERE Table_Name = 'CAT_DECLARATION_TYPE');

INSERT INTO SEC_TABLE_CONTROL (Table_Name, Creation_Date, Last_Update, Active)
SELECT 'CAT_FILE', datetime('now'), datetime('now'), 1
WHERE NOT EXISTS(SELECT 1 FROM SEC_TABLE_CONTROL WHERE Table_Name = 'CAT_FILE');
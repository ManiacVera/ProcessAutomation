<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ProcessAutomationMAUI.Pages.Security.AccountPage"
             xmlns:dtoInfo="clr-namespace:ProcessAutomationMAUI.DTO.Model"
             xmlns:resx="clr-namespace:ProcessAutomationMAUI.i18n.Pages.Security"
             Title="Account"
             BackgroundColor="{StaticResource bgPage}">
    <!--<ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding AppearingCommand}" EventName="Appearing" />
        <toolkit:EventToCommandBehavior Command="{Binding DisappearingCommand}" EventName="Disappearing" />
    </ContentPage.Behaviors>-->

    <Grid Margin="2, 10, 2, 10">
        <Border BackgroundColor="{StaticResource bgForm}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5"/>
            </Border.StrokeShape>

            <Grid Margin="0,14,0,14">
                <Border BackgroundColor="{StaticResource bgArea}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0"/>
                    </Border.StrokeShape>

                    <ScrollView>
                        <Grid Margin="4" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="4,20,4,20" Stroke="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5"/>
                                </Border.StrokeShape>

                                <Grid Margin="10,10,10,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Text="{x:Static resx:AccountPage.UserAccount}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start"
                                       Margin="0, 0, 0, 20"></Label>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="2" />
                                            </Border.StrokeShape>
                                            <Entry Text="{Binding AccountData.Email, Mode=OneWay}" IsEnabled="False" BackgroundColor="Gray"></Entry>
                                        </Border>
                                    </Grid>
                                    

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="2" />
                                            </Border.StrokeShape>
                                            <Entry Text="{Binding AccountData.OldPassword, Mode=TwoWay}" Placeholder="{x:Static resx:AccountPage.OldPassword}"></Entry>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="2" />
                                            </Border.StrokeShape>
                                            <Entry Text="{Binding AccountData.NewPassword, Mode=TwoWay}" Placeholder="{x:Static resx:AccountPage.NewPassword}"></Entry>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Text="{x:Static resx:AccountPage.ChangePassword}" Command="{Binding ChangePasswordCommand}"></Button>
                                    </Grid>

                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Margin="4,20,4,20" Stroke="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5"/>
                                </Border.StrokeShape>

                                <Grid Margin="10,10,10,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Text="{x:Static resx:AccountPage.LanguageTitle}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" Margin="0, 0, 0, 20"></Label>

                                    <Border Grid.Row="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="2" />
                                        </Border.StrokeShape>
                                        <Picker ItemDisplayBinding="{Binding Path=Language}" ItemsSource="{Binding LanguageList, Mode=OneWay}" SelectedItem="{Binding LanguageSelected, Mode=TwoWay}">
                                        </Picker>
                                    </Border>

                                    <Button Grid.Row="2" Text="{x:Static resx:AccountPage.Save}" Command="{Binding SaveCommand}"></Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollView>
                </Border>
            </Grid>
        </Border>
        <AbsoluteLayout BackgroundColor="#22000000" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding IsBusy,Mode=OneWay}">
            <AbsoluteLayout.GestureRecognizers>
                <TapGestureRecognizer />
            </AbsoluteLayout.GestureRecognizers>

            <StackLayout  Margin="0" Padding="0" AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize"
                                           AbsoluteLayout.LayoutFlags="PositionProportional" HorizontalOptions="CenterAndExpand" VerticalOptions="FillAndExpand" >
                <ActivityIndicator IsRunning="{Binding IsBusy, Mode=OneWay}" IsVisible="True" IsEnabled="True" Color="Orange" 
                               HorizontalOptions="CenterAndExpand"  VerticalOptions="CenterAndExpand"/>
            </StackLayout>
        </AbsoluteLayout>
    </Grid>
</ContentPage>
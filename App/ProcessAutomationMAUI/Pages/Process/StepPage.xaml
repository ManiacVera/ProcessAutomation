<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ProcessAutomationMAUI.Pages.Process.StepPage"
             xmlns:dtoInfo="clr-namespace:ProcessAutomationMAUI.DTO.Model"             
             Title="Input"
             BackgroundColor="{StaticResource bgPage}"
             xmlns:Converter="clr-namespace:ProcessAutomationMAUI.Converter">
    <ContentPage.Resources>
        <Converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"></Converter:BooleanToVisibilityConverter>
        <Converter:PickerSelectorConverter x:Key="PickerSelectorConverter"></Converter:PickerSelectorConverter>
        <Converter:BoolToColorConverter x:Key="BoolToColorConverter"></Converter:BoolToColorConverter>
    </ContentPage.Resources>
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding AppearingCommand}" EventName="Appearing" />
        <toolkit:EventToCommandBehavior Command="{Binding DisappearingCommand}" EventName="Disappearing" />
        <!--<toolkit:EventToCommandBehavior Command="{Binding BackButtonPressedCommand}" EventName="BackButtonPressed" />-->
    </ContentPage.Behaviors>

    <Grid Margin="2, 10, 2, 10">
        <Border BackgroundColor="{StaticResource bgForm}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5"/>
            </Border.StrokeShape>

            <Grid Margin="0,14,0,14">
                <Border BackgroundColor="{StaticResource bgArea}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0"/>
                    </Border.StrokeShape>

                    <ScrollView>
                        <Grid Padding="5" ColumnSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Text="Número:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding StepData.Number}" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>

                            <Label Grid.Row="1" Grid.Column="0" Text="Component:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Border Grid.Row="1" Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="2" />
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding BindingContext.ComponentList, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                    ItemDisplayBinding="{Binding Text}">
                                    <Picker.SelectedItem>
                                        <MultiBinding Converter="{StaticResource PickerSelectorConverter}" ConverterParameter="Value">
                                            <Binding Mode="TwoWay" Path="StepData.Component" />
                                            <Binding Mode="OneWay" Path="BindingContext.ComponentList" Source="{x:RelativeSource AncestorType={x:Type ContentPage}}" />
                                        </MultiBinding>
                                    </Picker.SelectedItem>
                                </Picker>
                            </Border>

                            <Label Grid.Row="2" Grid.Column="0" Text="Descripción:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Border Grid.Row="2" Grid.Column="1" Stroke="Black" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="2" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding StepData.Description}"></Entry>
                            </Border>

                            <Label Grid.Row="3" Grid.Column="0" Text="Enpcapsulated:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Border Grid.Row="3" Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="2" />
                                </Border.StrokeShape>
                                <Picker x:Name="picEncapsulated" ItemsSource="{Binding BindingContext.EncapsulatedList, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                    ItemDisplayBinding="{Binding Text}">
                                    <Picker.SelectedItem>
                                        <MultiBinding Converter="{StaticResource PickerSelectorConverter}" ConverterParameter="Value">
                                            <Binding Mode="TwoWay" Path="StepData.EncapsulatedPartitionType" />
                                            <Binding Mode="OneWay" Path="BindingContext.EncapsulatedList" Source="{x:RelativeSource AncestorType={x:Type ContentPage}}" />
                                        </MultiBinding>
                                    </Picker.SelectedItem>
                                </Picker>
                            </Border>

                            <Label Grid.Row="4" Grid.Column="0" Text="Variable:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Border Grid.Row="4" Grid.Column="1" Stroke="Black" StrokeThickness="1" Margin="0,2,0,2" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="2" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding StepData.Variable}"></Entry>
                            </Border>

                            <Label Grid.Row="5" Grid.Column="0" Text="Is public:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding StepData.IsPublicVariable}"></CheckBox>

                            <Label Grid.Row="6" Grid.Column="0" Text="Value:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Border Grid.Row="6" Grid.Column="1" Stroke="Black" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="2" />
                                </Border.StrokeShape>
                                <ScrollView MaximumHeightRequest="100" VerticalScrollBarVisibility="Always">
                                    <Editor Text="{Binding StepData.Value}" AutoSize="TextChanges"></Editor>
                                </ScrollView>
                            </Border>

                            <Label Grid.Row="7" Grid.Column="0" Text="Value by format:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Button Grid.Row="7" Grid.Column="1" Text="..."  VerticalOptions="Center" Style="{StaticResource PageLabel}" 
                                Command="{Binding BindingContext.ValueByFormatCommand, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                CommandParameter="{Binding StepData}" HorizontalOptions="Center"></Button>


                            <Label Grid.Row="8" Grid.Column="0" Text="Apply formula:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding StepData.ApplyFormula}" HorizontalOptions="Center"></CheckBox>

                            <Label Grid.Row="9" Grid.Column="0" Text="Value input type:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Border Grid.Row="9" Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="2" />
                                </Border.StrokeShape>
                                <Picker Grid.Row="9" Grid.Column="1" ItemsSource="{Binding BindingContext.TypeValueTypeList, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                    ItemDisplayBinding="{Binding Text}">
                                    <Picker.SelectedItem>
                                        <MultiBinding Converter="{StaticResource PickerSelectorConverter}" ConverterParameter="Value">
                                            <Binding Mode="TwoWay" Path="StepData.InputValueType" />
                                            <Binding Mode="OneWay" Path="BindingContext.TypeValueTypeList" Source="{x:RelativeSource AncestorType={x:Type ContentPage}}" />
                                        </MultiBinding>
                                    </Picker.SelectedItem>
                                </Picker>
                            </Border>

                            <Label Grid.Row="10" Grid.Column="0" Text="Value output type:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Border Grid.Row="10" Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="2" />
                                </Border.StrokeShape>
                                <Picker Grid.Row="10" Grid.Column="1" ItemsSource="{Binding BindingContext.ValueOutputTypeList, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                    ItemDisplayBinding="{Binding Text}">
                                    <Picker.SelectedItem>
                                        <MultiBinding Converter="{StaticResource PickerSelectorConverter}" ConverterParameter="Value">
                                            <Binding Mode="TwoWay" Path="StepData.OutputValueType" />
                                            <Binding Mode="OneWay" Path="BindingContext.ValueOutputTypeList" Source="{x:RelativeSource AncestorType={x:Type ContentPage}}" />
                                        </MultiBinding>
                                    </Picker.SelectedItem>
                                </Picker>
                            </Border>

                            <Label Grid.Row="11" Grid.Column="0" Text="Option value:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Button Grid.Row="11" Grid.Column="1" Text="..."  VerticalOptions="Center" Style="{StaticResource PageLabel}" 
                                Command="{Binding BindingContext.OptionValueByFormatCommand, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                CommandParameter="{Binding StepData}" HorizontalOptions="Center"></Button>

                            <Label Grid.Row="12" Grid.Column="0" Text="Type declaration:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Border Grid.Row="12" Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="2" />
                                </Border.StrokeShape>
                                <Picker Grid.Row="12" Grid.Column="1" ItemsSource="{Binding BindingContext.TypeValueOptionList, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                    ItemDisplayBinding="{Binding Text}">
                                    <Picker.SelectedItem>
                                        <MultiBinding Converter="{StaticResource PickerSelectorConverter}" ConverterParameter="Value">
                                            <Binding Mode="TwoWay" Path="StepData.ValueTypeDeclaration" />
                                            <Binding Mode="OneWay" Path="BindingContext.TypeValueOptionList" Source="{x:RelativeSource AncestorType={x:Type ContentPage}}" />
                                        </MultiBinding>
                                    </Picker.SelectedItem>
                                </Picker>
                            </Border>

                            <Label Grid.Row="13" Grid.Column="0" Text="Delay:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <Border Grid.Row="13" Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="2" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding StepData.Delay}" Keyboard="Numeric"></Entry>
                            </Border>

                            <Label Grid.Row="14" Grid.Column="0" Text="Required" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <CheckBox Grid.Row="14" Grid.Column="1" IsChecked="{Binding StepData.Required}" HorizontalOptions="Center"></CheckBox>

                            <Label Grid.Row="15" Grid.Column="0" Text="Async" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <CheckBox Grid.Row="15" Grid.Column="1" IsChecked="{Binding StepData.Async}" HorizontalOptions="Center"></CheckBox>

                            <Label Grid.Row="16" Grid.Column="0" Text="Log" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <CheckBox Grid.Row="16" Grid.Column="1" IsChecked="{Binding StepData.Log}" HorizontalOptions="Center"></CheckBox>

                            <Label Grid.Row="17" Grid.Column="0" Text="Disable" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                            <CheckBox Grid.Row="17" Grid.Column="1" IsChecked="{Binding StepData.Disable}" HorizontalOptions="Center"></CheckBox>

                            <StackLayout Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalOptions="Center" Spacing="20" Margin="0, 20, 0, 10">
                                <Button Text="Aceptar" Command="{Binding AcceptCommand}" ></Button>
                                <Button Text="Cancelar" Command="{Binding CancelCommand}"></Button>
                                <!--<Button Grid.Row="18" Grid.Column="1" Text="Borrar"  VerticalOptions="Center" Style="{StaticResource PageLabel}" 
                                    Command="{Binding BindingContext.StepDeleteCommand, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding}" HorizontalOptions="Center"></Button>-->
                            </StackLayout>

                        </Grid>
                    </ScrollView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
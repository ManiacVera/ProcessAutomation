<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ProcessAutomationMAUI.Pages.Process.ProcessPage"
             xmlns:dtoInfo="clr-namespace:ProcessAutomationMAUI.DTO.Model"
             xmlns:resx="clr-namespace:ProcessAutomationMAUI.i18n.Pages.Process"
             Title="Process"
             BackgroundColor="{StaticResource bgPage}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding AppearingCommand}" EventName="Appearing" />
        <toolkit:EventToCommandBehavior Command="{Binding DisappearingCommand}" EventName="Disappearing" />
    </ContentPage.Behaviors>

    <Grid Margin="2, 10, 2, 10">
        <Border BackgroundColor="{StaticResource bgForm}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5"/>
            </Border.StrokeShape>

            <Grid Margin="0,14,0,14">
                <Border BackgroundColor="{StaticResource bgArea}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0"/>
                    </Border.StrokeShape>

                    <ScrollView>
                        <Grid Margin="4" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="4,20,4,20" Stroke="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5"/>
                                </Border.StrokeShape>

                                <Grid Margin="10,10,10,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Text="{x:Static resx:ProcessPage.ProcessInformation}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start"
                                           Margin="0, 0, 0, 20"></Label>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0" Text="{x:Static resx:ProcessPage.File}" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>

                                        <Border Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="2" />
                                            </Border.StrokeShape>
                                            <Picker ItemDisplayBinding="{Binding}" ItemsSource="{Binding ProcessFileList, Mode=OneWay}" SelectedItem="{Binding ProcessFile, Mode=TwoWay}">
                                            </Picker>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="100"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="2" Text="{x:Static resx:ProcessPage.Open}" Margin="4" Command="{Binding ProcessOpenCommand}"></Button>
                                    </Grid>

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"></ColumnDefinition>
                                            <ColumnDefinition Width="100"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0" Text="Número:" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>

                                        <Border Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="2" />
                                            </Border.StrokeShape>
                                            <Entry Keyboard="Numeric" Text="{Binding ProcessData.Number, Mode=TwoWay}"></Entry>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0" Text="{x:Static resx:ProcessPage.ProcessName}" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>

                                        <Border Grid.Column="1" Stroke="White" StrokeThickness="2" Margin="0,2,0,2" BackgroundColor="White">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="2" />
                                            </Border.StrokeShape>
                                            <Entry Text="{Binding ProcessData.ProcessName, Mode=TwoWay}"></Entry>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                                <ColumnDefinition Width="*"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Text="{x:Static resx:ProcessPage.Save}" Margin="4" Command="{Binding ProcessSaveCommand}"></Button>
                                            <Button Grid.Column="1" Text="{x:Static resx:ProcessPage.Build}" Margin="4" Command="{Binding ProcessBuildCommand}"></Button>
                                        </Grid>
                                    </Grid>

                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Margin="4,20,4,20" Stroke="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5"/>
                                </Border.StrokeShape>

                                <Grid Margin="10,10,10,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="300"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Text="{x:Static resx:ProcessPage.TaskList}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" Margin="0, 0, 0, 20"></Label>

                                    <Button Grid.Row="1" Text="{x:Static resx:ProcessPage.AddTask}" Command="{Binding TaskAddCommand}"></Button>
                                    <ScrollView Grid.Row="2" BackgroundColor="White">
                                        <CollectionView ItemsSource="{Binding Path=TaskList}">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout ItemSpacing="2" Orientation="Vertical"/>
                                            </CollectionView.ItemsLayout>

                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="dtoInfo:TaskModel">
                                                    <Border HorizontalOptions="FillAndExpand">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="2"/>
                                                        </Border.StrokeShape>

                                                        <Grid Padding="5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30*"/>
                                                                <ColumnDefinition Width="150*"/>
                                                                <ColumnDefinition Width="50"/>
                                                                <ColumnDefinition Width="50"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Label Grid.Column="0" Text="{Binding Number}" TextColor="Black" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                                                            <Label Grid.Column="1" Text="{Binding Name}"  TextColor="Black" VerticalOptions="Center" Style="{StaticResource PageLabel}"></Label>
                                                            <ImageButton Grid.Column="2" Source="edit_icon.png" WidthRequest="32" HeightRequest="32"
                                                                         VerticalOptions="Center" Style="{StaticResource PageLabel}" Command="{Binding BindingContext.TaskEditCommand, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding}">
                                                                
                                                            </ImageButton>
                                                            <ImageButton Grid.Column="3" Source="delete_icon.png" WidthRequest="38" HeightRequest="38"
                                                                         VerticalOptions="Center" Style="{StaticResource PageLabel}" Command="{Binding BindingContext.TaskDeleteCommand, Source={x:RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding}">
                                                                
                                                            </ImageButton>
                                                        </Grid>

                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </ScrollView>

                                    <Button Grid.Row="3" Text="{x:Static resx:ProcessPage.AddTask}" Command="{Binding TaskAddCommand}"></Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollView>
                </Border>
            </Grid>
        </Border>
        <AbsoluteLayout BackgroundColor="#22000000" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsVisible="{Binding IsBusy,Mode=OneWay}">
            <AbsoluteLayout.GestureRecognizers>
                <TapGestureRecognizer />
            </AbsoluteLayout.GestureRecognizers>

            <StackLayout  Margin="0" Padding="0" AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize"
                                               AbsoluteLayout.LayoutFlags="PositionProportional" HorizontalOptions="CenterAndExpand" VerticalOptions="FillAndExpand" >
                <ActivityIndicator IsRunning="{Binding IsBusy, Mode=OneWay}" IsVisible="True" IsEnabled="True" Color="Orange" 
                                   HorizontalOptions="CenterAndExpand"  VerticalOptions="CenterAndExpand"/>
            </StackLayout>
        </AbsoluteLayout>
    </Grid>
</ContentPage>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>0.1.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Configurations>Debug;Release</Configurations>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<Target Name="CopyAssembly" AfterTargets="AfterBuild" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release'">
		<ItemGroup>
			<PackageInterface Include="$(TargetDir)/$(TargetFileName);" />
		</ItemGroup>
		<Message Text="Copy PackageInterface" Importance="normal" />
		<Copy SourceFiles="@(PackageInterface)" DestinationFolder="$(SolutionDir)/Build/Package" ContinueOnError="true" />
	</Target>
	
</Project>

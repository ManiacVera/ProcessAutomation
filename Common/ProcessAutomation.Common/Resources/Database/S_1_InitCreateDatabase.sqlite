WHERE NOT EXISTS(SELECT 1 FROM CAT_TOKEN_TYPE WHERE Token_Type_Code = 'T07EA12N');

INSERT INTO CAT_STATUS(Status,Number,ID_Status_Type, Alteration_Counter, ID_User_Created, Creation_Date,Active)
SELECT 'LOGIN',1,(SELECT ID_Status_Type FROM CAT_STATUS_TYPE WHERE Status_Type_Code = 'S08EA12N' LIMIT 1), 1, (SELECT ID_User FROM CAT_USER WHERE [User_Name] = 'PA_Admin' LIMIT 1), datetime('now'),1
WHERE NOT EXISTS(SELECT 1 FROM CAT_STATUS WHERE Status = 'LOGIN');


/****** Object:  Table CAT_TOKEN_TYPE ******/
CREATE TABLE IF NOT EXISTS CAT_TOKEN_TYPE
(
	ID_Token_Type INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Token_Type VARCHAR (50) NOT NULL,
	Token_Type_Code VARCHAR (10) NOT NULL,
	Alteration_Counter INTEGER NOT NULL,
	ID_User_Created INTEGER NOT NULL,
	Creation_Date DATETIME NOT NULL,
	ID_User_Modified INTEGER NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);
	

/****** Object:  Table CAT_DEVICE ******/
CREATE TABLE IF NOT EXISTS CAT_DEVICE
(
	ID_Device INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Device VARCHAR (50) NOT NULL,
	Device_Code VARCHAR (10) NOT NULL,
	Alteration_Counter INTEGER NOT NULL,
	ID_User_Created INTEGER NOT NULL,
	Creation_Date DATETIME NOT NULL,
	ID_User_Modified INTEGER NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);


/****** Object:  Table CAT_STATUS ******/
CREATE TABLE IF NOT EXISTS CAT_STATUS
(
	ID_Status INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Status VARCHAR (50) NOT NULL,
	Number INTEGER NOT NULL,
	ID_Status_Type INTEGER NOT NULL,
	Alteration_Counter INTEGER NOT NULL,
	ID_User_Created INTEGER NOT NULL,
	Creation_Date DATETIME NOT NULL,
	ID_User_Modified INTEGER NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);


/****** Object:  Table CAT_STATUS_TYPE ******/
CREATE TABLE IF NOT EXISTS CAT_STATUS_TYPE
(
	ID_Status_Type INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Status_Type VARCHAR (50) NOT NULL,
	Status_Type_Code VARCHAR (10) NOT NULL,
	Alteration_Counter INTEGER NOT NULL,
	ID_User_Created INTEGER NOT NULL,
	Creation_Date DATETIME NOT NULL,
	ID_User_Modified INTEGER NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);


/****** Object:  Table CAT_USER ******/
CREATE TABLE IF NOT EXISTS CAT_USER
(
	ID_User INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	User_Name VARCHAR (50) NULL,
	Password VARCHAR (50) NULL,
	Name varchar(100) NOT NULL,
	Last_Name varchar(100) NULL,
	Email varchar(100) NULL,
	Photo VARCHAR(100) NULL,
	Birthdate DATETIME NULL,
	Alteration_Counter INTEGER NOT NULL,
	ID_User_Created INTEGER NOT NULL,
	Creation_Date DATETIME NOT NULL,
	ID_User_Modified INTEGER NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL
);


/****** Object:  Table MESSAGE_ADMIN ******/
CREATE TABLE IF NOT EXISTS MESSAGE_ADMIN
(
	ID_Message_Admin INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	ID_User INTEGER NOT NULL,
	Message varchar(1000) NOT NULL,
	Message_Type varchar(30) NOT NULL,
	Creation_Date DATETIME NOT NULL,
	Modification_Date DATETIME NULL,
	Active INTEGER NOT NULL,
	FOREIGN KEY (ID_User) REFERENCES CAT_USER (ID_User) ON DELETE CASCADE ON UPDATE NO ACTION
);


/****** Object:  Table TOKEN ******/
CREATE TABLE IF NOT EXISTS TOKEN
(
	ID_Token INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	Token varchar(100) NOT NULL,
	Expiration_Date DATETIME NOT NULL,
	Finish_Date DATETIME NULL,
	ID_Token_Type INTEGER NOT NULL,
	ID_User_Created INTEGER NOT NULL,
	Creation_Date DATETIME NOT NULL,
	Active INTEGER NOT NULL,
	FOREIGN KEY (ID_Token_Type) REFERENCES CAT_TOKEN_TYPE (ID_Token_Type) ON DELETE CASCADE ON UPDATE NO ACTION
);

	
CREATE TABLE IF NOT EXISTS USER_LOGIN
(
	ID_User_Login INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	ID_User INTEGER NOT NULL,
	ID_Token INTEGER NOT NULL,
	ID_Device INTEGER NOT NULL,
	Login_Date DATETIME NOT NULL,
	Login_Latitude varchar(30) NOT NULL,
	Login_Longitude varchar(30) NOT NULL,
	Logout_Date DATETIME NULL,
	Logout_Latitude varchar(30) NULL,
	Logout_Longitude varchar(30) NULL,
	Alteration_Counter INTEGER NOT NULL,
	ID_User_Created INTEGER NOT NULL,
	Creation_Date DATETIME NOT NULL,
	ID_User_Modified INTEGER NULL,
	Modification_Date DATETIME NULL,
	FOREIGN KEY (ID_User) REFERENCES CAT_USER (ID_User) ON DELETE CASCADE ON UPDATE NO ACTION,
	FOREIGN KEY (ID_Token) REFERENCES TOKEN (ID_Token) ON DELETE CASCADE ON UPDATE NO ACTION,
	FOREIGN KEY (ID_Device) REFERENCES CAT_DEVICE (ID_Device) ON DELETE CASCADE ON UPDATE NO ACTION
);


INSERT INTO CAT_USER (User_Name, Password, Name, Last_Name, Email, Photo, BirthDate,Alteration_Counter, ID_User_Created, Creation_Date, Active)
SELECT 'PA_Admin', '', 'Super', 'User', 'pa_admin@processautomation.com', NULL, NULL, 1, 0, datetime('now'), 1
WHERE NOT EXISTS(SELECT 1 FROM CAT_USER WHERE User_Name = 'PA_Admin');

INSERT INTO CAT_STATUS_TYPE (Status_Type, Status_Type_Code, Alteration_Counter, ID_User_Created, Creation_Date, Active) 
SELECT 'AUTHENTICATION', 'S08EA12N', 1, (SELECT ID_User FROM CAT_USER WHERE [User_Name] = 'PA_Admin' LIMIT 1), datetime('now'), 1
WHERE NOT EXISTS(SELECT 1 FROM CAT_STATUS_TYPE WHERE Status_Type_Code = 'S08EA12N');

INSERT INTO CAT_TOKEN_TYPE (Token_Type, Token_Type_Code, Alteration_Counter, ID_User_Created, Creation_Date, Active) 

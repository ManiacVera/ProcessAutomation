    <Copy SourceFiles="@(PackageFormCss)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomation/Form/AngularJS/css" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageFormJS)" DestinationFolder="$(SolutionDir)/Build/App/ProcessAutomation/Form/AngularJS/js" ContinueOnError="true" />-->

    <Copy SourceFiles="@(PackageFormAngular)" DestinationFolder="$(SolutionDir)/Build/Resources/Scripts/AngularJS/angular" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageFormCss)" DestinationFolder="$(SolutionDir)/Build/Resources/Scripts/AngularJS/css" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageFormJS)" DestinationFolder="$(SolutionDir)/Build/Resources/Scripts/AngularJS/js" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageConfig)" DestinationFolder="$(SolutionDir)/Build/Config" ContinueOnError="true" />
  </Target>

  <Target Name="CopyRuntimeFiles" AfterTargets="AfterBuild" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release' OR '$(Configuration)'=='DebugMAC' OR '$(Configuration)'=='ReleaseMAC'">
    <ItemGroup>
      <CopyRuntimeCommon Include="$(TargetDir)runtimes\$(ActiveCommonFolder)\**\*.*" />
      <CopyRuntimeSpecific Include="$(TargetDir)runtimes\$(ActiveRuntime)\**\*.*" />
    </ItemGroup>

    <Message Text="Copy CopyRuntimeFiles" Importance="high" />
    <Copy SourceFiles="@(CopyRuntimeCommon)" DestinationFolder="$(SolutionDir)/Build/runtimes/$(ActiveCommonFolder)/%(RecursiveDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(CopyRuntimeSpecific)" DestinationFolder="$(SolutionDir)/Build/runtimes/$(ActiveRuntime)/%(RecursiveDir)" ContinueOnError="true" />
  </Target>


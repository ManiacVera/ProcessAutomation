<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Model\CHAT.cs" />
    <Compile Remove="Model\CHAT_MESSAGE.cs" />
    <Compile Remove="Model\CHAT_USER_MESSAGE.cs" />
    <Compile Remove="Resources\ProcessProgramFormat.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Form\Diagram.html" />
    <None Remove="Form\InputFieldsVisor.html" />
    <None Remove="Form\OutputValueOption.html" />
    <None Remove="Form\InputFields.html" />
    <None Remove="Form\InputTextField.html" />
    <None Remove="Form\shapes.js" />
    <None Remove="Resources\Database\S_1_InitCreateDatabase.sql" />
    <None Remove="Resources\Database\S_1_InitCreateDatabase.sqlite" />
    <None Remove="Resources\ServerConnection.json" />
    <None Remove="Resources\UserSettings.json" />
    <None Remove="Resources\StatementList.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Form\Diagram.html" />
    <EmbeddedResource Include="Form\OutputValueOption.html" />
    <EmbeddedResource Include="Form\InputFieldsVisor.html" />
    <EmbeddedResource Include="Form\InputTextField.html" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Form\InputFields.html"></EmbeddedResource>
    <EmbeddedResource Include="Form\shapes.js" />
    <EmbeddedResource Include="Resources\Database\S_1_InitCreateDatabase.sql" />
    <EmbeddedResource Include="Resources\Database\S_1_InitCreateDatabase.sqlite" />
    <Content Include="Config\ServerConnection.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\UserSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Resources\ProcessProgramFormat.cs" />
    <EmbeddedResource Include="Resources\StatementList.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Form\Scripts\**\*.*" />
    <Content Include="Form\Scripts\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageReference Include="PCRE.NET" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Framework\ProcessAutomation.Framework\ProcessAutomation.Framework.csproj" />
    <ProjectReference Include="..\ProcessAutomation.Common.DTO\ProcessAutomation.Common.DTO.csproj" />
    <ProjectReference Include="..\..\Common\ProcessAutomation.CommonExpress\ProcessAutomation.CommonExpress.csproj" />
  </ItemGroup>

  <Target Name="CleanProcessAutomationFiles" AfterTargets="AfterBuild">
    <ItemGroup>
      <RootFolderFiles Include="$(TargetDir)*.*" />
      <ProtectedFiles Include="$(TargetDir)ProcessAutomation*" />
      <FilesToDelete Include="@(RootFolderFiles)" Exclude="@(ProtectedFiles)" />
      <AllSubdirectories Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)'))" />      
      <ProtectedFolders Include="$(TargetDir)runtimes" />
      <ProtectedFolders Include="$(TargetDir)Config" />
      <ProtectedFolders Include="$(TargetDir)Form" />
      <FoldersToDelete Include="@(AllSubdirectories)" Exclude="@(ProtectedFolders)" />
    </ItemGroup>

    <Delete Files="@(FilesToDelete)" />    
    <RemoveDir Directories="@(FoldersToDelete)" />    
    <Message Text="[Cleanup] Unused root files and folders removed. Kept 'runtimes', 'Config', 'Form', and 'ProcessAutomation*' files successfully." Importance="high" />
  </Target>

  <Target Name="CopyAssembly" AfterTargets="AfterBuild" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release'">
    <ItemGroup>
      <PackageCommon Include="$(TargetDir)/$(TargetFileName);" />
      <PackageFormScripts Include="$(TargetDir)Form/Scripts/**/*.*" />
      <PackageConfig Include="$(TargetDir)/Config/*;" />
    </ItemGroup>
    <Message Text="Copy PackageCommon" Importance="normal" />
    <Copy SourceFiles="@(PackageCommon)" DestinationFolder="$(SolutionDir)/Build/Package" ContinueOnError="true" />

    <Message Text="Copy Angular Forms" Importance="normal" />
    <Copy SourceFiles="@(PackageFormScripts)" DestinationFiles="@(PackageFormScripts->'$(SolutionDir)Build\Resources\Scripts\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="@(PackageConfig)" DestinationFolder="$(SolutionDir)/Build/Config" ContinueOnError="true" />
  </Target>

  <Target Name="CopyRuntimeFiles" AfterTargets="AfterBuild" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release' OR '$(Configuration)'=='DebugMAC' OR '$(Configuration)'=='ReleaseMAC'">
    <ItemGroup>
      <CopyRuntimeCommon Include="$(TargetDir)runtimes\$(ActiveCommonFolder)\**\*.*" />
      <CopyRuntimeSpecific Include="$(TargetDir)runtimes\$(ActiveRuntime)\**\*.*" />
    </ItemGroup>

    <Message Text="Copy CopyRuntimeFiles" Importance="high" />
    <Copy SourceFiles="@(CopyRuntimeCommon)" DestinationFolder="$(SolutionDir)/Build/runtimes/$(ActiveCommonFolder)/%(RecursiveDir)" ContinueOnError="true" />
    <Copy SourceFiles="@(CopyRuntimeSpecific)" DestinationFolder="$(SolutionDir)/Build/runtimes/$(ActiveRuntime)/%(RecursiveDir)" ContinueOnError="true" />
  </Target>

</Project>

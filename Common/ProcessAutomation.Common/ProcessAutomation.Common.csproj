  <Target Name="CleanProcessAutomationFiles" AfterTargets="AfterBuild">
    <ItemGroup>
      <RootFolderFiles Include="$(TargetDir)*.*" />
      <ProtectedFiles Include="$(TargetDir)ProcessAutomation*" />
      <FilesToDelete Include="@(RootFolderFiles)" Exclude="@(ProtectedFiles)" />

      <AllSubdirectories Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)'))" />
      
      <ProtectedFolders Include="$(TargetDir)runtimes" />
      <ProtectedFolders Include="$(TargetDir)Config" />
      <ProtectedFolders Include="$(TargetDir)Form" />
      
      <FoldersToDelete Include="@(AllSubdirectories)" Exclude="@(ProtectedFolders)" />
    </ItemGroup>

    <Delete Files="@(FilesToDelete)" />
    
    <RemoveDir Directories="@(FoldersToDelete)" />
    
    <Message Text="[Cleanup] Unused root files and folders removed. Kept 'runtimes', 'Config', 'Form', and 'ProcessAutomation*' files successfully." Importance="high" />
  </Target>

  <Target Name="CopyAssembly" AfterTargets="AfterBuild" Condition="'$(Configuration)'=='Debug' OR '$(Configuration)'=='Release'">
    <ItemGroup>
      <PackageCommon Include="$(TargetDir)/$(TargetFileName);" />
      <!--<PackageFormHtml Include="$(TargetDir)/Form/*.html;" /> -->
      <PackageFormAngular Include="$(TargetDir)/Form/Scripts/AngularJS/angular/*;" />
      <PackageFormCss Include="$(TargetDir)/Form/Scripts/AngularJS/css/*;" />
      <PackageFormJS Include="$(TargetDir)/Form/Scripts/AngularJS/js/*;" />
      <PackageConfig Include="$(TargetDir)/Config/*;" />
    </ItemGroup>
    <Message Text="Copy PackageCommon" Importance="normal" />
    <Copy SourceFiles="@(PackageCommon)" DestinationFolder="$(SolutionDir)/Build/Package" ContinueOnError="true" />
    <!--<Message Text="Copy Form" Importance="normal" />
    <Copy SourceFiles="@(PackageFormHtml)" DestinationFolder="$(SolutionDir)/Build/App/Form" ContinueOnError="true" /> -->

    <Message Text="Copy Angular Forms" Importance="normal" />
